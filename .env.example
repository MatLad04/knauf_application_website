# Only needed for `npm run dev` on the host. `docker compose up` sets this itself.
#
# The compose file publishes Postgres on host port 55432 rather than 5432, so a
# Postgres you already run locally keeps working.
DATABASE_URL=postgres://kernbau:kernbau@localhost:55432/kernbau

# Host port for the app when running under Docker. Default 3000.
APP_PORT=3000
